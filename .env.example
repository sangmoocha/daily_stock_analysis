# ===================================
# A주 자선주 지능 분석 시스템 - 환경 변수 설정 템플릿
# 이 파일을 .env로 복사한 후 실제 설정값을 입력하세요
# ===================================

# 자선주 목록 (쉼표로 구분, 상해·심천 양 시장 코드 지원)
# 상해: 600xxx, 601xxx, 603xxx
# 심천: 000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594

# Futu OpenD (보유 종목 가져오기)
# --portfolio futu 는 ACTIVE REAL NORMAL / MASTER 계좌의 상해·심천 A주, 홍콩주, 미국주 LONG 주식 보유만 읽습니다.
# futu-api 10.8은 IPv4만 지원합니다. Docker에서 호스트 OpenD에 연결할 때 컨테이너 내부의 127.0.0.1을 사용하지 마세요. 자세한 내용은 docs/full-guide.md 참고.
# FUTU_OPEND_HOST=127.0.0.1
# FUTU_OPEND_PORT=11111
# FUTU_HK_REALTIME_SOURCE_PRIORITY=futu,longbridge,akshare,yfinance
# FUTU_SECURITY_FIRM=NONE          # 선택 사항; 기본값은 OpenD가 자동 인식, 증권사 명시 지정도 가능
# FUTU_ACC_ID=                     # 선택 사항; 양의 정수, 지정 시 해당 실계좌만 읽음

# Anspire Open API Keys (여러 개 지원, 쉼표 구분)
# 발급: https://open.anspire.cn/?share_code=QFBC0FYC
# 더 높은 우선순위의 OpenAI-compatible 소스가 없을 때, 조건 충족 시 이 키를 Anspire 대모델 게이트웨이와 뉴스 검색에 재사용할 수 있습니다.
# 아래 게이트웨이·모델은 현재 프로젝트 예시 설정이며, 실제 사용 가능 여부는 Anspire 콘솔과 공식 문서를 확인하세요:
# 예시 게이트웨이: https://open-gateway.anspire.cn/v6
# 예시 모델: Doubao-Seed-2.0-lite (ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-pro 로 덮어쓸 수 있음)
# 게이트웨이에 지역/버전 차이가 있으면 ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.ai/v6 로 덮어쓰기 가능
ANSPIRE_API_KEYS=
# ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-lite
# ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
# ANSPIRE_LLM_ENABLED=true

# 데이터 소스 설정
# Tushare Pro Token (선택 사항, https://tushare.pro/weborder/#/login?reg=834638 에서 발급)
TUSHARE_TOKEN=
# Tushare Pro 커스텀 접속 주소 (선택 사항, 기본값 http://api.tushare.pro)
# 사용 시나리오: 공식 인터페이스에 직접 접속할 수 없을 때 자체 구축 게이트웨이 또는 제3자 호환 미러를 가리킴
# 주의: 비공식 접속 주소를 사용하면 Token과 모든 요청 내용이 해당 제3자 서버를 거치므로 데이터 보안 위험을 스스로 평가하세요
# 반드시 http:// 또는 https:// 로 시작해야 함; 비워두면 공식 기본 주소 유지
# TUSHARE_HTTP_URL=http://api.tushare.pro

# TickFlow API Key (선택 사항; A주 일봉, 실시간 시세, 종목 목록/이름 및 시장 복기 강화용, 권한 부족 시 자동 폴백)
# TICKFLOW_API_KEY=
# TICKFLOW_KLINE_ADJUST=none          # none/forward/backward/forward_additive/backward_additive
# TICKFLOW_BATCH_DAILY_ENABLED=true   # 권한이 있을 때 TickFlow로 일봉 일괄 미리 가져오기
# TICKFLOW_BATCH_SIZE=100             # TickFlow 한 번에 요청할 수 있는 최대 종목 수

# 묘상(동방재부 MX_API) API Key —— 엄격한 opt-in 제3자 기능: 사용자가 직접 Key를 준비해야 함(묘상 Skills 페이지에서 발급),
# 현재 기간 한정 무료/회원 할당량 정책이 변경될 수 있으며 장기 무료를 보장하지 않음; 설정하지 않으면 시스템 동작은 완전히 동일
# 설정 후: 동방재부 공개 인터페이스가 제한될 때 칩 분포와 개별 종목 자금 흐름을 백업으로 가져옴
# MX_APIKEY=
# MX_PRIORITY=6                       # 묘상 데이터 소스 우선순위, 기본값 6 (내장 데이터 소스 뒤)

# 종목 선별 (AlphaSift 구현 참고, 기본 비활성; 보통 Web「기본 설정」의 종목 선별 스위치로 관리)
SCREENING_ENABLED=false
# 전시장 스냅샷 소스 우선순위; 설정하지 않으면 DSA가 TUSHARE_TOKEN 유무에 따라 자동 주입:
# - TUSHARE_TOKEN 있음: tushare,sina,efinance,akshare_em,em_datacenter
# - TUSHARE_TOKEN 없음: sina,efinance,akshare_em,em_datacenter
# SNAPSHOT_SOURCE_PRIORITY=tushare,sina,efinance,akshare_em,em_datacenter
# (런타임 자동 주입과 일치하게 유지하려면 이 파일에 값을 고정하지 말고 비워두는 것을 권장)
# 종목 선별 제3자 데이터 소스 호출 타임아웃 가드.
# - SCREENING_SOURCE_CALL_TIMEOUT_SEC 는 전역 폴백; 0/off/disabled 로 설정하면 caller-side timeout 비활성
# - Hotspot/SNAPSHOT/Daily 전용 값이 전역 값보다 우선; 기본값은 각각 8s / 60s / 20s
# - 핫스팟 기본 provider는 양의 값을 단일 섹터/구성종목/상세 fallback 호출 예산으로 사용하고, 남은 시간을 종료 가능한
#   AkShare 서브프로세스와 HTTP 소켓에 전달; 0/off 는 전체 호출 예산만 끄고, 단일 소스 하드 타임아웃은 유지
# SCREENING_SOURCE_CALL_TIMEOUT_SEC=
# SCREENING_HOTSPOT_CALL_TIMEOUT_SEC=8
# 사용자가 직접 핫스팟 메시지를 검색할 때의 종단 간 대기 상한, 캐시 owner 대기와 provider 실행을 포함
# 이 경로는 종료 가능한 서브프로세스 하드 데드라인 필요, 0/off 는 안전한 기본값 12초로 폴백
# SCREENING_HOTSPOT_SEARCH_TIMEOUT_SEC=12
# SCREENING_SNAPSHOT_CALL_TIMEOUT_SEC=60
# SCREENING_DAILY_CALL_TIMEOUT_SEC=20
# 종목 선별의 동방재부 직접 요청 속도 제한과 랜덤 지터
# SCREENING_EASTMONEY_MIN_INTERVAL_SEC=1.0
# SCREENING_EASTMONEY_JITTER_SEC=0.3
# 종목 선별은 last-good 스냅샷, 일봉 이력, 업종/컨셉 provider 캐시를 지원하며, 기본 디렉터리는 data/screening
# 커스텀이 필요하면 아래 경로를 덮어쓸 수 있음; 비워두면 기존 DSA 설정을 변경하지 않음
# SCREENING_DATA_DIR=data/screening
# SCREENING_FALLBACK_SNAPSHOT_PATH=data/screening/snapshot.last_good.json
# 5분 이내 반복 종목 선별은 기본적으로 최근 성공한 전시장 스냅샷을 재사용; 0으로 설정하면 비활성
# SCREENING_SNAPSHOT_CACHE_TTL_SEC=300
# SCREENING_DAILY_HISTORY_CACHE_DIR=data/screening/daily_history
# 일봉 캐시 기본 TTL 24시간, 최신 마감 거래일을 반드시 포함; 마감 전 캐시가 마감을 넘으면 새로고침
# 달력이 사용 불가할 때는 TTL 판단 유지; 새로고침 실패 시 이전 일봉은 품질 점수와 리스크 페널티에 반영
# SCREENING_INDUSTRY_PROVIDER_CACHE_DIR=data/screening/industry_provider_cache
# 종목 선별의 업종/컨셉 provider는 기본 비활성; akshare를 켜면 theme_heat, 업종 열도, LLM 컨텍스트에 더 많은 섹터 정보 제공 가능
# INDUSTRY_PROVIDER=none
# INDUSTRY_PROVIDER_MAX_BOARDS=80
# 한국 종목 선별(KOSPI/KOSDAQ)은 기본적으로 scripts/stock_index_seeds/stock_list_kr.csv 의 DART/KRX 종목 풀을 사용,
# 시세는 Naver Finance에서 가져옴; 동결 패키지 환경에서는 static/stocks.index.json 으로 폴백
# 커스텀 종목 풀이 필요하면 CSV seed 또는 DSA stock index JSON을 가리킬 수 있음
# SCREENING_KR_UNIVERSE_FILE=
# 단일 LLM 요청 타임아웃(초); 종목 선별이 이 설정을 재사용하며, 타임아웃 후 비 LLM 정렬 결과로 폴백
# LLM_TIMEOUT_SEC=60
# 종목 선별 LLM 재정렬 요청 출력 상한, 기본값 2048
# LLM_MAX_TOKENS=2048

# Finnhub (선택 사항, 미국 주식 데이터 소스, 무료 티어 60 calls/min)
# 발급: https://finnhub.io/register
# FINNHUB_API_KEY=

# AlphaVantage (선택 사항, 미국 주식 데이터 소스, 무료 티어 25 calls/day)
# 발급: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Longbridge OpenAPI (선택 사항, 미국/홍콩 주식 거래량 비율, 회전율, PE 등 필드 백업)
# https://open.longbridge.com/ 에서 발급
# OAuth 2.0 (권장): 먼저 scripts/generate_longbridge_oauth_token.py 를 실행해 로컬 SDK 토큰 캐시 생성
# client_id 는 LONGBRIDGE_OAUTH_CLIENT_ID 를 우선 사용; 비어 있고 Legacy Access Token이 없으면 LONGBRIDGE_APP_KEY 를 호환 사용
# GitHub Actions / Docker에서는 토큰 캐시 파일을 base64 후 LONGBRIDGE_OAUTH_TOKEN_CACHE_B64 에 채울 수 있음
# LONGBRIDGE_OAUTH_CLIENT_ID=
# LONGBRIDGE_OAUTH_TOKEN_CACHE_B64=
# Legacy API Key (구 계정 호환; Access Token은 OAuth access token이 아님)
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=
# static_info 프로세스 내 캐시 초, 기본값 86400; 0=매번 요청 시 가져오기
# LONGBRIDGE_STATIC_INFO_TTL_SECONDS=86400
# 연결 종료 계열 예외 후 쿨다운 초, 기본값 15; 쿨다운 기간 동안 Longbridge를 임시로 건너뛰어 요청 단위 빈번한 재연결 방지
# LONGBRIDGE_CONNECTION_COOLDOWN_SECONDS=15
# Longbridge SDK 언어는 REPORT_LANGUAGE(zh/en)와 일치; SDK 로그는 LOG_DIR/longbridge_sdk.log 에 기록
# 접속점 (REPORT_LANGUAGE와 무관; 비워두면 아래 기본값 사용):
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.com
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.com/v2
# LONGBRIDGE_TRADE_WS_URL=wss://openapi-trade.longbridge.com/v2
# LONGBRIDGE_REGION=hk
# 접속점 덮어쓰기; SDK 내부에서는 LONGPORT_REGION(BRIDGE 없음)으로 자동 선택,
# 코드가 LONGBRIDGE_REGION → LONGPORT_REGION 을 자동 동기화
# hk → *.longbridge.com  |  cn → *.longbridge.cn
# 나머지: https://open.longbridge.com/zh-CN/docs/getting-started#환경변수
# 야간 시세 true/false, 기본값 false
# LONGBRIDGE_ENABLE_OVERNIGHT=false
# K선 푸시 realtime 또는 confirmed, 기본값 realtime
# LONGBRIDGE_PUSH_CANDLESTICK_MODE=realtime
# 연결 시 시세 패키지 출력 여부 (README / full-guide와 일치: 미설정 시 앱 측 기본값 비활성, false와 동일)
# 1 / true / yes 로 설정하면 SDK 상세 시세 패키지 로그 활성화 (Longbridge 연결 디버깅 시 사용)
# LONGBRIDGE_PRINT_QUOTE_PACKAGES=false

# 주식 자동완성 인덱스 원격 업데이트 (기본 활성; GitHub 접근 불가 시 로컬 내장 인덱스로 자동 폴백)
STOCK_INDEX_REMOTE_UPDATE_ENABLED=true

# 한국 주식 자동완성 seed 새로고침 (선택 사항, 관리자가 인덱스 새로고침할 때만 필요)
# scripts/fetch_dart_stock_list.py 와 scripts/refresh_stock_index.py --refresh-kr 에서만 사용
# 비워두면 저장소 내장 scripts/stock_index_seeds/stock_list_kr.csv 계속 사용
# Key 발급: https://opendart.fss.or.kr/
# DART_API_KEY=

# ===================================
# DART Insight 연동 (선택 사항)
# ===================================
# 별도 프로세스인 dart-dashboard 조회 API로 회사명을 넘겨
# 기업 개황 / 국민연금 가입자·직원 비교 / 재무제표 / 공시 / 지배구조를 받아옵니다.
# DART 수집·캐시(MariaDB) 로직은 그쪽에 있으므로 이 저장소에서는 HTTP 로만 위임합니다.
#
# 비워두면 연동이 비활성화되고, /api/v1/dart-insight/* 는 503 을 돌려줍니다.
# 주의: 이 앱의 기본 포트도 3000 이므로 dart-dashboard 를 다른 포트로 띄우세요.
#       예) dart-dashboard: PORT=3210 npm run build && node --env-file=.env .output/server/index.mjs
# DART_INSIGHT_BASE_URL=http://127.0.0.1:3210
# 기본값 20초 (1~300)
# DART_INSIGHT_TIMEOUT_SECONDS=20
# false 로 두면 연동을 끕니다 (기본 true)
# DART_INSIGHT_ENABLED=true

# ===================================
# AI 모델 설정
# ===================================
# 전체 설명: docs/LLM_CONFIG_GUIDE.md
#
# 【빠른 시작】모델 접속 방식 하나를 선택하고, 검색 Key는 별도 설정
#   Modelflare (OpenAI Compatible) → MODELFLARE_KEY 만 입력하면 기본 주소와 모델 자동 사용
#   Gemini (무료 할당량) → GEMINI_API_KEY 입력
#   DeepSeek (가성비 좋음) → DEEPSEEK_API_KEY 입력
#   AIHubmix (통합 플랫폼) → AIHUBMIX_KEY 입력
#
# 【고급】다중 모델 / 다중 플랫폼 fallback 필요 → 아래「다중 채널」설정 또는 Web 설정 페이지에서 시각적으로 관리
# 각 채널은 LLM_<CHANNEL>_API_SURFACE 로 chat_completions(기본) 또는 responses 를 명시적으로 선택 가능
# responses 는 PROTOCOL=openai 가 필요하고, MODELS 에 anthropic/, gemini/, xai/ 등 LiteLLM 직접 연결 provider 접두사를 사용할 수 없음;
# 게이트웨이 고유의 슬래시 포함 모델 ID(예: deepseek-ai/DeepSeek-V3)는 OpenAI-compatible 모델 ID로 라우팅
# 같은 정규화 모델 별칭이 chat_completions 와 responses 채널에 동시에 나타날 수 없음; 두 Surface가 필요하면 다른 별칭 사용
# 한 채널 내 모델은 반드시 같은 API Surface 사용; 실패 후 엔드포인트 자동 전환에 의존하지 말 것
# Anspire /models 와 연결 테스트에서 대상 모델이 Responses를 사용한다고 확인되면(예: 현재 관측된 GPT-5.6 sol/terra/luna),
# 채널 모드를 사용하고 LLM_ANSPIRE_API_SURFACE=responses 로 설정
# ===================================

# 생성 백엔드: 기본 litellm; codex_cli / claude_code_cli / opencode_cli 는 명시적 opt-in 로컬 CLI 백엔드 (experimental/limited)
# OpenCode CLI 는 로컬 OpenCode의 기본 모델을 사용; OPENCODE_CLI_MODEL 은 선택적 --model 덮어쓰기
# 로컬 CLI Backend ≠ 오프라인 모델, CLI 뒤의 서비스가 주식 코드, 뉴스, 보유 컨텍스트, 분석 프롬프트, 보고서 초안을 처리할 수 있음
# Docker / CI / 원격 서버는 데스크톱 CLI 로그인 상태를 기본적으로 갖지 않음; DSA는 Claude/OpenCode credential 파일을 읽지 않음
# DSA는 최소 env allowlist + provider credential denylist 로 API keys / webhook tokens 유출 위험을 낮춤
# Web 설정 페이지의 빠른 검사는 설정과 실행 파일 가시성만 읽음; JSON 테스트만이 실제 generation backend smoke 요청을 보냄
GENERATION_BACKEND=litellm
# OPENCODE_CLI_MODEL=provider/model
# 백엔드 레벨 fallback; 로컬 .env 빈 값은 backend-level fallback 비활성, litellm -> litellm 은 no-op 으로 해석
# 기본 GitHub Actions workflow 가 이 변수를 설정하지 않으면 litellm 을 명시적으로 사용; Actions에서 fallback을 끄려면 primary backend로 self no-op 설정
GENERATION_FALLBACK_BACKEND=litellm
# 로컬 CLI 백엔드 실행 상한; timeout 최대 3600, 출력 최대 33554432 bytes, 동시성 최대 각각 16 / 4
GENERATION_BACKEND_TIMEOUT_SECONDS=300
GENERATION_BACKEND_MAX_OUTPUT_BYTES=1048576
GENERATION_BACKEND_MAX_CONCURRENCY=1
LOCAL_CLI_BACKEND_MAX_CONCURRENCY=1
# 문주 Chat 실행 방식; auto(권장)와 litellm 은 현재 기본 모델 경로 유지, codex_app_server 는 DSA 백엔드 기기에서 Codex 호출
# (실험, macOS/Linux/완전한 WSL 백엔드의 single-agent Chat만 지원; 네이티브 Windows 미지원). 설정 페이지는 시도 가능 여부만 확인, 첫 실제 질문에서 로그인·모델·도구 실행을 검증
AGENT_BACKEND=auto
# 구 Agent 모델 라우팅 호환 항목; 일반 사용자는 Web 설정 페이지에서 AGENT_BACKEND 사용
AGENT_GENERATION_BACKEND=auto

# --- API Key (하나만 입력하면 됨) ---

# Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
# 다중 Key 로드밸런싱: GEMINI_API_KEYS=key1,key2,key3

# DeepSeek (https://platform.deepseek.com)
# 호환 기본값: DEEPSEEK_API_KEY 만 입력해도 deepseek-chat 사용, 로그에서 deepseek-v4-flash 로 마이그레이션 안내
# DEEPSEEK_API_KEY=

# AIHubmix 통합 (https://inferera.com/?aff=CfMq)
# 하나의 Key로 GPT/Claude/Gemini/GLM/Qwen 등 모델 사용, 과학 인터넷 불필요
# AIHUBMIX_KEY=

# Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=

# OpenAI / 호환 API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # 제3자 API 주소(중계소/프록시), 비워두면 공식 사용

# Ollama 로컬 모델 (API Key 불필요, 권장)
# OLLAMA_API_BASE=http://localhost:11434
# LITELLM_MODEL=ollama/qwen3:8b
#
# 또는 채널 모드 사용:
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b

# 샘플링 온도 (0.0-2.0, 기본값 0.7; 0은 결정성 최고, 2는 무작위성 최고)
# 엄격한 temperature 호환 출처:
# - Moonshot API / 모델 문서: https://platform.kimi.ai/docs/guide/kimi-k2-6-quickstart
# - Moonshot 공식 모델 카드 (평가 기본 temperature = 1.0): https://huggingface.co/moonshotai/Kimi-K2.6
# - OpenAI Chat Completions 규격: https://platform.openai.com/docs/api-reference/chat/create
# - LiteLLM OpenAI-Compatible 규격: https://docs.litellm.ai/docs/providers/openai_compatible
# 현재 저장소 런타임 의존성 제약: litellm>=1.80.10,!=1.82.7,!=1.82.8,<1.99.0 (PyPI 사고 버전을 명시적으로 제외하고 상한을 검증된 버전으로 수렴, requirements.txt 참고)
# 따라서 kimi-k2.6 은 자동으로 1.0/0.6 사용; GPT-5 / o 시리즈 등 기본 온도 모델은 temperature를 생략해 API 거부 방지
# 호환 플랫폼이 명확한 파라미터 미지원 오류를 반환하면, 런타임이 현재 요청 내에서 파라미터를 수정하고 한 번 재시도; 성공 전략은 프로세스 내 캐시만 수행
# top_p, presence_penalty, frequency_penalty, seed 가 “파라미터 미지원”을 반환해도 이번 요청 단위 수정·재시도 발생 (LLM_TEMPERATURE 는 변경하지 않음)
# 다른 모델과 fallback은 사용자가 설정한 LLM_TEMPERATURE 사용
# Web 설정 페이지 / 데스크톱 가져오기는 LLM_TEMPERATURE 를 조용히 비우거나 바꾸지 않음; 실제 요청 직전에만 모델 파라미터를 임시 적응
# 주 모델이 일반 모델로 돌아가면 원래 설정한 온도가 자동 복원; 최소 롤백 방법은 이번 LLM 파라미터 적응 변경을 되돌리는 것
# LLM_TEMPERATURE=0.7

# LLM 사용량 텔레메트리 message HMAC 설정 (선택 사항)
# 기본 비워두면 시스템이 데이터 디렉터리에 .llm_usage_hmac_secret 을 생성, 로컬 배포 내에서 안정적으로 비교 가능
# 배포 간 usage message HMAC 비교가 필요할 때만 동일한 랜덤 키를 명시적으로 설정; 교체 시 버전 태그도 동기 업데이트
# 명시 설정 시 높은 엔트로피 랜덤 값 사용 (예: openssl rand -hex 32), 실제 키를 버전 관리에 커밋하지 말 것
# LLM_USAGE_HMAC_SECRET=
# LLM_USAGE_HMAC_KEY_VERSION=local-v1

# Provider prompt cache 설정 (선택 사항)
# TELEMETRY 는 provider cache usage / diagnostics 기록만 제어; provider implicit cache 는 제어하지 않음
# HINTS 는 prompt_cache_key, cache_control, user_id 등 검증된 provider-specific hint 를 능동적으로 보낼지 제어; 기본 비활성
# DIAGNOSTICS_LEVEL 은 off/basic/debug 선택 가능; debug 도 마스킹된 진단만 출력, raw prompt 나 request body 는 기록하지 않음
# LLM_PROMPT_CACHE_TELEMETRY_ENABLED=true
# LLM_PROMPT_CACHE_HINTS_ENABLED=false
# LLM_PROMPT_CACHE_DIAGNOSTICS_LEVEL=off

# --- 다중 채널 설정 (선택 사항, Web 설정 페이지에서도 가능) ---
# 각 채널 독립적으로 base_url / api_key / models 설정, 다중 Key 로테이션과 자동 fallback 지원
#
# 예시: DeepSeek + Gemini 이중 채널
# LLM_CHANNELS=deepseek,gemini
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LLM_GEMINI_API_KEYS=key1,key2
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview
#
# 예시: 커스텀 API 엔드포인트 (제3자 프록시 / 통합 플랫폼 / 중계소)
# LLM_CHANNELS=my_proxy
# LLM_MY_PROXY_BASE_URL=https://your-proxy.example.com/v1
# LLM_MY_PROXY_API_KEY=sk-xxx
# LLM_MY_PROXY_MODELS=gpt-5.5,claude-sonnet-4-6
# LLM_MY_PROXY_PROTOCOL=openai
#
# 예시: Ollama 로컬 모델 (API Key 불필요)
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b,llama3.2
#
# 예시: Hermes 로컬 HTTP generation (Phase 3, 일반 분석/JSON만; Agent tools, Stream, Vision 미지원)
# LLM_CHANNELS=hermes
# LLM_HERMES_PROTOCOL=openai
# LLM_HERMES_BASE_URL=http://127.0.0.1:8642/v1
# LLM_HERMES_API_KEY=sk-local-hermes
# LLM_HERMES_MODELS=hermes-agent
# LITELLM_MODEL=openai/hermes-agent
#
# 자주 쓰는 벤더 템플릿 (하나 선택해 .env에 복사; 전체 설명은 docs/llm-providers.md)
#
# Modelflare (OpenAI Compatible)
# 등록: https://modelflare.dev/sign-up?utm_source=github&utm_campaign=daily_stock_analysis
# 단일 채널 기본 모델 gpt-6.1-sol; 실제 사용 가능 여부는 계정 권한, 콘솔, 연결 테스트 기준
# 이 Key만 설정하면 채널명, 주소, 모델 입력 불필요:
MODELFLARE_KEY=
# 고급 덮어쓰기 (선택 사항):
# LLM_CHANNELS=modelflare
# LLM_MODELFLARE_API_KEY=sk-xxx
# 고급 선택: LLM_MODELFLARE_MODELS=  # 명시적 채널 목록 우선, 다중 채널은 각각 모델 선언 필요
# 선택 덮어쓰기: LLM_MODELFLARE_BASE_URL=https://modelflare.dev/v1
# 선택 프로토콜: LLM_MODELFLARE_PROTOCOL=openai
# 기본 프로토콜 openai, 인터페이스 chat_completions; 단일 채널에서 주 모델과 모델 목록이 없으면 기본 gpt-6.1-sol
#
# AIHubmix 통합 플랫폼 (OpenAI Compatible)
# LLM_CHANNELS=aihubmix
# LLM_AIHUBMIX_PROTOCOL=openai
# LLM_AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# LLM_AIHUBMIX_API_KEY=sk-xxx
# LLM_AIHUBMIX_MODELS=gpt-5.5,claude-sonnet-4-6,gemini-3.1-pro-preview
# LITELLM_MODEL=openai/gpt-5.5
#
# OpenAI 공식
# LLM_CHANNELS=openai
# LLM_OPENAI_PROTOCOL=openai
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_API_KEY=sk-xxx
# LLM_OPENAI_MODELS=gpt-5.5,gpt-5.4-mini
# LITELLM_MODEL=openai/gpt-5.5
#
# DeepSeek 공식
# LLM_CHANNELS=deepseek
# LLM_DEEPSEEK_PROTOCOL=deepseek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# LITELLM_MODEL=deepseek/deepseek-v4-flash
#
# Gemini 공식 (공식 프로토콜, Base URL 비움)
# LLM_CHANNELS=gemini
# LLM_GEMINI_PROTOCOL=gemini
# LLM_GEMINI_API_KEY=xxx
# LLM_GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview
# LITELLM_MODEL=gemini/gemini-3.1-pro-preview
#
# Anthropic Claude 공식 (공식 프로토콜, Base URL 비움)
# LLM_CHANNELS=anthropic
# LLM_ANTHROPIC_PROTOCOL=anthropic
# LLM_ANTHROPIC_API_KEY=sk-ant-xxx
# LLM_ANTHROPIC_MODELS=claude-sonnet-4-6,claude-opus-4-7
# LITELLM_MODEL=anthropic/claude-sonnet-4-6
#
# Kimi / Moonshot (OpenAI Compatible)
# LLM_CHANNELS=moonshot
# LLM_MOONSHOT_PROTOCOL=openai
# LLM_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# LLM_MOONSHOT_API_KEY=sk-xxx
# LLM_MOONSHOT_MODELS=kimi-k2.6,kimi-k2.5
# LITELLM_MODEL=openai/kimi-k2.6
#
# 통의천문 DashScope (OpenAI Compatible)
# LLM_CHANNELS=dashscope
# LLM_DASHSCOPE_PROTOCOL=openai
# LLM_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DASHSCOPE_API_KEY=sk-xxx
# LLM_DASHSCOPE_MODELS=qwen3.6-plus,qwen3.6-flash
# LITELLM_MODEL=openai/qwen3.6-plus
#
# 지푸 GLM (OpenAI Compatible)
# LLM_CHANNELS=zhipu
# LLM_ZHIPU_PROTOCOL=openai
# LLM_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_ZHIPU_API_KEY=xxx
# LLM_ZHIPU_MODELS=glm-5.1,glm-4.7-flash
# LITELLM_MODEL=openai/glm-5.1
#
# MiniMax (OpenAI Compatible)
# 출처: 공식 OpenAI API 호환 문서 https://platform.minimax.io/docs/api-reference/text-chat
# LiteLLM 은 openai/<model> 로 호환 Chat Completions Base URL에 라우팅
# LLM_CHANNELS=minimax
# LLM_MINIMAX_PROTOCOL=openai
# LLM_MINIMAX_BASE_URL=https://api.minimax.io/v1
# LLM_MINIMAX_API_KEY=xxx
# LLM_MINIMAX_MODELS=MiniMax-M2.7,MiniMax-M2.7-highspeed
# LITELLM_MODEL=openai/MiniMax-M2.7
#
# 샤오미 MiMo (OpenAI Compatible)
# Base URL과 모델명은 MiMo 공식 문서/콘솔 기준
# LLM_CHANNELS=mimo
# LLM_MIMO_PROTOCOL=openai
# LLM_MIMO_BASE_URL=
# LLM_MIMO_API_KEY=sk-xxx
# LLM_MIMO_MODELS=mimo-xxx
# LITELLM_MODEL=openai/mimo-xxx
# 참고: 저장소 기본 daily_analysis workflow 는 LLM_MIMO_* 를 명시적으로 전달하지 않음. 이 예시는 기본적으로 로컬 .env, Docker 또는 자체 호스팅 스크립트에 적합; Actions 사용 시 workflow 매핑을 함께 보완할 것
#
# 화산방주 / 도우바오 (OpenAI Compatible, 실제 개통 지역에 따라 endpoint 조정)
# 출처: 화산방주 온라인 추론 / Responses API 문서 https://www.volcengine.com/docs/82379/2121998
# LiteLLM 은 openai/<model> 로 호환 Chat Completions Base URL에 라우팅
# LLM_CHANNELS=volcengine
# LLM_VOLCENGINE_PROTOCOL=openai
# LLM_VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_VOLCENGINE_API_KEY=xxx
# LLM_VOLCENGINE_MODELS=doubao-seed-1-6-251015,doubao-seed-1-6-thinking-251015
# LITELLM_MODEL=openai/doubao-seed-1-6-251015
#
# 실리콘플로우 SiliconFlow (OpenAI Compatible)
# 출처: 공식 모델 목록 https://docs.siliconflow.cn/quickstart/models
# LLM_CHANNELS=siliconflow
# LLM_SILICONFLOW_PROTOCOL=openai
# LLM_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# LLM_SILICONFLOW_API_KEY=sk-xxx
# LLM_SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V3.2,Qwen/Qwen3-235B-A22B-Thinking-2507
# LITELLM_MODEL=openai/deepseek-ai/DeepSeek-V3.2
#
# OpenRouter (OpenAI Compatible)
# 출처: 공식 Models API https://openrouter.ai/docs/api/api-reference/models/get-models
# LLM_CHANNELS=openrouter
# LLM_OPENROUTER_PROTOCOL=openai
# LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_OPENROUTER_API_KEY=sk-or-xxx
# LLM_OPENROUTER_MODELS=~anthropic/claude-sonnet-latest,~openai/gpt-latest
# LITELLM_MODEL=openai/~anthropic/claude-sonnet-latest
#
# Requesty (OpenAI Compatible)
# 출처: 공식 Models API https://docs.requesty.ai/api-reference/endpoint/models-list
# 예시 모델은 슬래시 없는 managed 모델 ID; Base URL이 requesty.ai 를 가리킬 때, vendor/model ID(예: anthropic/claude-sonnet-4-6)는 자동으로 openai/ 게이트웨이 라우팅이 붙고 그대로 전송, Web「모델 가져오기」체크 후 openai/<vendor>/<model> 로 저장
# openai/ 로 시작하는 ID는 LiteLLM 라우팅 접두사와 중복되므로, 수동 입력 시 openai/openai/gpt-4o-mini 로 써야 함
# EU 지역은 Base URL을 https://router.eu.requesty.ai/v1 로 변경 가능
# LLM_CHANNELS=requesty
# LLM_REQUESTY_PROTOCOL=openai
# LLM_REQUESTY_BASE_URL=https://router.requesty.ai/v1
# LLM_REQUESTY_API_KEY=xxx
# LLM_REQUESTY_MODELS=claude-sonnet-4-6,gpt-5.4
# LITELLM_MODEL=openai/claude-sonnet-4-6

# Anspire Open 호환 예시 (검색과 LLM Key 공유, OpenAI Compatible)
# LLM_CHANNELS=anspire
# LLM_ANSPIRE_PROTOCOL=openai
# LLM_ANSPIRE_BASE_URL=https://open-gateway.anspire.cn/v6  # 예시 게이트웨이
# LLM_ANSPIRE_API_KEY=sk-xxx
# LLM_ANSPIRE_MODELS=Doubao-Seed-2.0-lite,Doubao-Seed-2.0-pro  # 예시 모델
# LITELLM_MODEL=openai/Doubao-Seed-2.0-lite  # 예시 주 모델

# 고급: 모델 라우팅 YAML 설정 (선택 사항, docs/examples/litellm_config.example.yaml 참고)
# LITELLM_CONFIG=./litellm_config.yaml

# ===================================
# 검색 엔진 설정 (주식 뉴스 수집용)
# ===================================
# Bocha API Keys (중국어 검색 최적화, AI 요약 지원, 여러 개 지원, 쉼표 구분)
# 발급: https://open.bocha.cn/
# BOCHA_API_KEYS=your_bocha_key_here
# MiniMax API Key (Coding Plan Web Search, 여러 개 지원, 쉼표 구분)
# 발급: https://platform.minimax.io/
# MINIMAX_API_KEYS=your_minimax_key_here
# Tavily API Keys (여러 개 지원, 쉼표 구분)
TAVILY_API_KEYS=
# SerpAPI Keys (여러 개 지원, 쉼표 구분)
SERPAPI_API_KEYS=
# Brave Search API Keys (여러 개 지원, 쉼표 구분)
# 발급: https://brave.com/search/api/
BRAVE_API_KEYS=
# SearXNG 인스턴스 주소 (쉼표 구분, 사설 배포 할당량 없음, settings.yml 에서 format: json 활성화 필요)
# GitHub Actions 일일 분석 워크플로는 동일 이름 Variables 우선, Secrets 폴백 지원; 공용 주소는 Variable로 설정 가능
# 비워두고 아래 스위치가 true이면 searx.space 에서 공용 인스턴스를 자동 가져옴. 공용 인스턴스는 일반적으로 속도 제한(429),
# 오프라인(503) 또는 JSON 출력 미활성 상태가 많아, 하나씩 재시도하면 분석마다 30~60초가 더 걸리고 뉴스면이 결국 비어
# 있으므로 기본 비활성. 자체 구축 인스턴스 주소(SEARXNG_BASE_URLS) 설정 또는 위의 Key 있는 검색 채널 사용을 권장
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=false
# 자체 구축 SearXNG 단일 검색 타임아웃 (초, 기본 10, 최소 1); 공용 인스턴스는 이 설정의 영향 없음
SEARXNG_TIMEOUT_SECONDS=10

# ===================================
# Social Sentiment Intelligence (미국 주식 전용)
# ===================================
# Reddit / X (Twitter) / Polymarket 감정 데이터 from api.adanos.org
# 미국 주식 티커(AAPL, TSLA 등)에만 활성화, A주/홍콩주는 무시
# 무료 티어: 250 requests/month | 등록: https://api.adanos.org
# SOCIAL_SENTIMENT_API_KEY=sk_live_your_key_here
# SOCIAL_SENTIMENT_API_URL=https://api.adanos.org

# ===================================
# 뉴스 시효 및 분석 필터 설정
# ===================================
# 뉴스 전략 창 등급: ultra_short(1일) / short(3일) / medium(7일) / long(30일)
# 실제 창 = min(전략 창, NEWS_MAX_AGE_DAYS)
# NEWS_STRATEGY_PROFILE=short
# 뉴스 최대 시효 (일), 검색 시 결과를 최근으로 제한해 오래된 정보 사용 방지
# NEWS_MAX_AGE_DAYS=3
# 로컬 정보/인텔리전스 풀 보관 일수; intelligence_items 정보 풀만 정리, 과거 보고서에는 영향 없음
# NEWS_INTEL_RETENTION_DAYS=30
# 단일 RSS/Atom 정보 소스 가져오기 타임아웃 (초)
# NEWS_INTEL_FETCH_TIMEOUT_SEC=8
# 한 번에 각 정보 소스에서 최대 수집 건수
# NEWS_INTEL_MAX_ITEMS_PER_SOURCE=50
# 켜면 개별 종목 분석, Agent 분석, 시장 복기에서 로컬 정보 풀을 읽기 전에 내장 정보 소스를 자동 초기화하고 활성 소스를 가져옴;
# 기본 비활성, 확인되지 않은 외부 요청과 분석 입력 변화 방지
# 참고: 저장소 기본 daily_analysis workflow 는 이 변수를 명시적으로 전달하지 않음. Actions 사용 시 workflow 매핑을 함께 보완할 것
# NEWS_INTEL_AUTO_FETCH_ENABLED=false
# NewsNow HTTP API 기본 주소 —— 외부 의존성 설정
# - 공식 프로젝트 및 배포 가이드: https://github.com/qqhann/newsnow
# - 현재 기본값 https://newsnow.busiyi.world 는 공개 예시 인스턴스이며 다음 위험이 있음:
#   * 공식 유지보수나 속도 제한으로 사용 불가할 수 있음
#   * 안정성·데이터 신뢰성을 보장하지 않으며 데모·테스트용
# - 운영 환경에서는 자체 구축 NewsNow 인스턴스로 변경해 통제성과 안정성을 확보할 것을 강력 권장
# - 배포 전 API 계약 호환성 검증 권장 (docs/intelligence-sources.md 참고):
#   curl -sS "https://newsnow.busiyi.world/api/s?id=cls-hot" | python -c "import sys, json; data=json.load(sys.stdin); assert isinstance(data.get('items'), list)"
# - 이 설정은 정보 소스 수집·정리 동작만 제어하며, LLM / provider / base URL / 호환 폴백 의미는 변경하지 않음
# NEWSNOW_BASE_URL=https://newsnow.busiyi.world
# 괴리율 임계값 (%), MA5에서 이 값을 초과하면 고가 추격 경고; 강한 추세 종목은 자동으로 1.5배로 완화
# BIAS_THRESHOLD=5.0

# ===================================
# Agent 전략 대화 설정 (Web 대화 페이지)
# ===================================
# Agent 전략 대화 활성화 (기본 false, 내부 통일 명칭 skill)
# AGENT_MODE=true
# 기본 모델 문주의 주 모델 (선택 사항): 비워두면 주 모델 상속; provider 접두사 없으면 openai/<model> 로 해석; Codex는 이 항목 사용 안 함
# AGENT_LITELLM_MODEL=
# Agent 자원 상한: 기본 모델은 추론 단계 수 상한으로 사용 (기본 10일 때 각 서브 Agent는 자체 프리셋으로 실행); Codex는 한 번 문주의 도구 호출 횟수 상한으로 사용
# AGENT_MAX_STEPS=10
# 기본 활성 전략 (쉼표 구분), 설정하지 않으면 아래 내장 기본값 사용
#
# 내장 전략 스킬 목록 (자유롭게 조합 가능):
#   bull_trend          — 다두 추세 (MA5>MA10>MA20 배열 + 낮은 괴리율)
#   ma_golden_cross     — 이동평균 골든크로스 (MA5가 MA10/MA20 상향 돌파)
#   volume_breakout     — 거래량 돌파 (가격이 최근 고점 돌파 + 거래량 확대)
#   hot_theme           — 핫 테마 (정책/산업 핫이슈, 섹터 확산과 개별 종목 상관성)
#   event_driven        — 이벤트 드리븐 (실적, 정책, 주문, 인수합병 등 촉매 이벤트)
#   growth_quality      — 성장 품질 (매출·이익, ROE, 현금흐름과 성장 지속성)
#   expectation_repricing — 기대 재평가 (실적/정책/밸류에이션 기대 차이 복구 또는 실화)
#   shrink_pullback     — 거래량 축소 조정 (이동평균 재터치 + 거래량 위축, 저점 매수 포인트)
#   bottom_volume       — 바닥 거래량 확대 (바닥 거래량에서 바닥 가격, 바닥 반전 신호)
#   dragon_head         — 용두 전략 (강한 용두, 추세 지속 추격)
#   one_yang_three_yin  — 일양삼음 (주력 세력 조정 후 강한 반포 형태)
#   box_oscillation     — 박스권 횡보 (구간 고점 매도·저점 매수)
#   chan_theory          — 선론 (선중설선 이론: 필/선분/중추)
#   wave_theory         — 파동 이론 (엘리엇 파동 카운트)
#   emotion_cycle       — 감정 사이클 (시장 감정 고저점 순환)
#
# 비워두면 시스템이 metadata에 선언된 주 기본 전략 skill 사용 (내장 기본값은 bull_trend)
# AGENT_SKILLS=
#
# 수동으로 전략 그룹 지정 가능:
# AGENT_SKILLS=bull_trend,ma_golden_cross,shrink_pullback
#
# 내장 전략 전부 활성화 (두 작성법 동일):
# AGENT_SKILLS=all
# AGENT_SKILLS=bull_trend,ma_golden_cross,volume_breakout,hot_theme,event_driven,growth_quality,expectation_repricing,shrink_pullback,bottom_volume,dragon_head,one_yang_three_yin,box_oscillation,chan_theory,wave_theory,emotion_cycle
#
AGENT_SKILLS=
# 커스텀 전략 디렉터리 (선택 사항, 커스텀 YAML 전략 파일 배치; 환경 변수명은 내부 skill 명명 유지)
# AGENT_SKILL_DIR=./strategies

# Agent 아키텍처 모드 (기본 single; multi 는 다중 Agent 오케스트레이션 모드)
# AGENT_ARCH=single

# Multi-Agent 오케스트레이션 모드 (AGENT_ARCH=multi 일 때만 유효)
# quick: 기술분석→의사결정 (가장 빠름, 약 2회 LLM 호출)
# standard: 기술→정보→의사결정 (기본)
# full: 기술→정보→리스크관리→의사결정
# specialist: 기술→정보→리스크관리→전략 전문가 평가→의사결정
# AGENT_ORCHESTRATOR_MODE=standard

# Agent 실행 타임아웃 예산 (초; 기본 LiteLLM 경로는 0으로 비활성 가능; Codex는 반드시 0보다 커야 하며 매번 문주가 끝나도록 보장; 기본 600)
# AGENT_ORCHESTRATOR_TIMEOUT_S=600

# 서브 Agent 독립 타임아웃 상한 (초, 0=비활성; 180 같은 양수로 설정하면 해당 Agent에 독립 하드 상한 적용)
# 적용 규칙:
#   - Pipeline 총 예산 비활성 (AGENT_ORCHESTRATOR_TIMEOUT_S=0) 시: 서브 Agent 상한이 독립적으로 적용, 해당 Agent의 절대 타임아웃
#   - Pipeline 총 예산 활성 시: 실제 상한 = min(Pipeline 남은 예산, 서브 Agent 상한), 둘 중 작은 값
#   - 미설정 (기본 0) 시: 독립 상한 없음, Pipeline 남은 예산만 제약
# AGENT_TECHNICAL_AGENT_TIMEOUT_S=0
# AGENT_INTEL_AGENT_TIMEOUT_S=0
# AGENT_RISK_AGENT_TIMEOUT_S=0
# AGENT_DECISION_AGENT_TIMEOUT_S=0
# AGENT_PORTFOLIO_AGENT_TIMEOUT_S=0
# AGENT_SKILL_AGENT_TIMEOUT_S=0

# Agent 도구 카테고리별 기본 타임아웃 (초, 0=비활성; 미설정 시 전역 tool_call_timeout_seconds 예산으로 폴백)
# 유효 타임아웃은 first-wins 해석: 명시적 per-run tool_call_timeout_seconds > 단일 도구 명시 timeout_seconds > 카테고리 기본값 > 무제한;
# 남은 wall-clock 예산은 돌파 불가능한 외부 cap으로만 작용; inf/nan/음수는 무제한으로 취급
# market 계열 도구 (get_market_indices / get_sector_rankings 등 네트워크 데이터 호출) 는 AGENT_DATA_TOOL_TIMEOUT_S 를 재사용, 독립 스위치 없음
# AGENT_DATA_TOOL_TIMEOUT_S=0
# AGENT_SEARCH_TOOL_TIMEOUT_S=0
# AGENT_ANALYSIS_TOOL_TIMEOUT_S=0
# AGENT_ACTION_TOOL_TIMEOUT_S=0

# 전략 전문가 동시성 수 (specialist 모드에서만 유효; 범위 1-4, 기본 3)
# AGENT_SKILL_CONCURRENCY=3

# 리스크관리 Agent가 매수 신호를 거부할 수 있는지 (기본 활성)
# AGENT_RISK_OVERRIDE=true

# 기억·캘리브레이션 시스템 (과거 정확도 추적, 신뢰도 자동 조절)
# AGENT_MEMORY_ENABLED=false

# 표본이 충분한 실제 Skill Outcome 기반 보수적 가중 전략 의견
# AGENT_SKILL_AUTOWEIGHT=true

# 전략 라우팅 모드 (auto=시장 상태에 따라 자동 선택 / manual=AGENT_SKILLS 목록 사용)
# AGENT_SKILL_ROUTING=auto

# 문주 가시 대화 컨텍스트 압축 (기본 비활성). 켜면 사용자가 볼 수 있는 user/assistant 이력만 압축, 같은 라운드 tool/thinking 전달에는 영향 없음
# AGENT_CONTEXT_COMPRESSION_ENABLED=false
# 압축 전략: cost=토큰 절약 / balanced=균형 / long_context_raw_first=원문 더 많이 보존 우선
# AGENT_CONTEXT_COMPRESSION_PROFILE=balanced
# 압축을 트리거하는 이력 토큰 임계값; 비워두면 현재 profile preset 따름
# AGENT_CONTEXT_COMPRESSION_TRIGGER_TOKENS=
# 압축 시 최근 N개 사용자 턴과 그 이후 응답은 원문 유지; 비워두면 현재 profile preset 따름
# AGENT_CONTEXT_PROTECTED_TURNS=

# 이벤트 알림 모니터링 (schedule 모드 백그라운드 폴링; 트리거 후 이미 설정된 알림 채널 재사용)
# 호환성 설명: 이 섹션은 알림 규칙 설정만 추가하며, 모델명, provider, Base URL, LiteLLM 또는 LLM 설정 의미는 변경하지 않음; 롤백은 이벤트 모니터링 설정만 끄거나 제거하면 됨
# legacy JSON 은 세 가지 single-symbol 기본 규칙만 지원; 기술 지표, 자선주, 보유/계좌, 시장 신호등 규칙은 Web/API 알림 센터에서 설정
# legacy JSON 지원 규칙:
#   price_cross          — 가격 돌파 임계값, direction: above / below, 필드: price
#   price_change_percent — 등락률 임계값, direction: up / down, 필드: change_pct (단위: %)
#   volume_spike         — 거래량 급증, 필드: multiplier (최근 20일 평균 거래량 배수)
# AGENT_EVENT_MONITOR_ENABLED=false
# AGENT_EVENT_MONITOR_INTERVAL_MINUTES=5
# AGENT_EVENT_ALERT_RULES_JSON=[{"stock_code":"600519","alert_type":"price_cross","direction":"above","price":1800},{"stock_code":"300750","alert_type":"price_change_percent","direction":"down","change_pct":3.0},{"stock_code":"000858","alert_type":"volume_spike","multiplier":2.5}]

# ====== 딩톡 로봇 (DingTalk) ======
# 딩톡 그룹 로봇의 Webhook URL
DINGTALK_WEBHOOK_URL=
# 딩톡 로봇의 서명 검증 키 (SEC로 시작하는 문자열), 서명 검증을 켜지 않았으면 비워둘 수 있음
DINGTALK_SECRET=

# ===================================
# 알림 채널 설정 (여러 개 동시 설정 가능, 전부 푸시)
# ===================================
#
# 【방식 1】기업 위챗 로봇
# 기업 위챗 그룹 -> 설정 -> 그룹 로봇 -> 추가 -> Webhook 주소 복사
#
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
#
# 【방식 2】페이슈 로봇 (둘 중 하나)
#
# 방식 2a — 그룹 커스텀 로봇 Webhook
# 페이슈 그룹 -> 설정 -> 그룹 로봇 -> 로봇 추가 -> 커스텀 로봇 -> Webhook 주소 복사
#
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_key_here
# 로봇 보안 설정에서 “서명 검증”을 켠 경우 secret도 함께 입력
# FEISHU_WEBHOOK_SECRET=your_feishu_webhook_secret
# 로봇 보안 설정에서 “키워드”를 켠 경우 같은 키워드 입력; 시스템이 모든 메시지 앞에 자동으로 붙임
# FEISHU_WEBHOOK_KEYWORD=주식일보
#
# 방식 2b — 페이슈 앱 로봇 (App Bot) 푸시
# 페이슈 개방 플랫폼에서 앱 생성, im:message 권한 활성화 후 배포
#
# 그룹 채팅 모드 (권장): 로봇을 대상 그룹에 초대, 그룹 설정에서 chat_id 획득
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=chat_id
#
# 개인 채팅 모드: 지정 사용자에게 직접 개인 메시지. 사용자의 open_id 는 로봇 이벤트 또는 연락처 API에서 획득
# FEISHU_APP_ID=cli_xxxxxxxxxxxxx
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_CHAT_ID=ou_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=open_id
# FEISHU_DOMAIN=feishu  # 도메인: feishu(페이슈 국내) / lark(국제판 larksuite.com)
#
# 【방식 3】Telegram 로봇 (두 항목 모두 필요)
# 1. Telegram에서 @BotFather -> /newbot -> Bot Token 획득
# 2. Chat ID 획득: @userinfobot 에 메시지 보내거나 https://api.telegram.org/bot<token>/getUpdates 방문
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=2780
#
# 【방식 4】이메일 푸시 (2개 설정만 필요, SMTP 자동 인식)
# QQ메일, 163메일, Gmail 등 SMTP 인증코드/기본 인증을 지원하는 메일 지원
# Outlook / Exchange 가 테넌트에서 OAuth2를 강제하면 현재 버전은 미지원
# 1. 인증코드 획득 (QQ메일 예시): 설정 -> 계정 -> POP3/SMTP서비스 -> 활성화 -> 인증코드 획득
# 2. 아래 두 항목만 입력하면 됨:
#
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=receiver@example.com  # 선택 사항, 비워두면 자신에게 발송
#
# 【방식 4 확장】주식 그룹별 다른 이메일 발송 (Issue #268, 선택 사항)
# STOCK_LIST 가 실제 분석 범위를 결정; STOCK_GROUP_N 은 메일을 누구에게 보낼지만 결정, 항상 STOCK_LIST 의 부분집합으로 작성 권장
# Telegram / 기업 위챗 / Webhook 등 다른 채널은 여전히 전체 STOCK_LIST 로 푸시, 그룹 때문에 분리되지 않음
# 현재 저장소 기본 GitHub Actions daily_analysis workflow 는 임의의 번호 STOCK_GROUP_N / EMAIL_GROUP_N 을 자동 주입하지 않음
# 따라서 이 기능은 로컬 .env, Docker, 또는 이 변수들을 명시적으로 주입한 실행 환경에 적합
# STOCK_GROUP_1=600519,300750
# EMAIL_GROUP_1=user1@example.com
# STOCK_GROUP_2=002594,AAPL
# EMAIL_GROUP_2=user2@example.com
#
# 【방식 5】커스텀 Webhook (여러 개 지원, 쉼표 구분)
# 적용: 딩톡, Discord, Slack, Bark, 자체 구축 서비스 등 POST JSON 을 지원하는 모든 Webhook
# 시스템이 자주 쓰는 서비스를 자동 인식하고 해당 형식 사용
#
# CUSTOM_WEBHOOK_URLS=https://oapi.dingtalk.com/robot/send?access_token=xxx,https://hooks.slack.com/services/xxx
# CUSTOM_WEBHOOK_BEARER_TOKEN=  # 선택 사항, 인증이 필요한 Webhook용 (Header Authorization: Bearer <token>)
# CUSTOM_WEBHOOK_BODY_TEMPLATE=  # 선택 사항, 전역 JSON body 템플릿, Bark/Slack/Discord 등 자동 payload 덮어씀; $content_json/$title_json 권장
# Docker Compose 에서 직접 .env 작성 시 $$content_json/$$title_json 로 작성; Web 설정 페이지는 자동 이스케이프, 런타임에는 다시 단일 $ 로 복원
# WEBHOOK_VERIFY_SSL=true   # 기본 검증; 이 설정을 읽는 webhook-style HTTPS 알림 요청에 영향. false 로 설정하면 자체 서명 인증서 지원. 경고: 비활성 시 MITM 하이재킹 위험, 신뢰할 수 있는 내부망에서만
#
# 【방식 6】Pushover 설정
# Pushover 계정 등록 후 앱 Token 생성 https://pushover.net/apps/build
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=
#
# 【방식 6 확장】ntfy 설정
# NTFY_URL 은 반드시 topic path 포함, 예: https://ntfy.sh/my-topic 또는 https://self-hosted:port/my-topic
# 시스템이 topic 을 파싱하고 ntfy JSON publish API 로 Markdown 텍스트 전송
# NTFY_URL=
# NTFY_TOKEN=  # 선택 사항, Bearer Token 이 필요한 topic 또는 자체 구축 ntfy 서버용
#
# 【방식 6 확장】Gotify 설정
# GOTIFY_URL 은 Gotify 서버 base URL, /message 포함하지 않음; 시스템이 /message 를 붙이고 X-Gotify-Key Header 로 token 전송
# GOTIFY_URL=
# GOTIFY_TOKEN=  # Gotify application token
#
# 【방식 7】PushPlus 설정 (국내 푸시 서비스, 권장)
# PushPlus 계정 등록 후 Token 발급 https://www.pushplus.plus
# PUSHPLUS_TOKEN=
# 그룹 푸시: 그룹 코드 입력 후 그룹 구독자 전원에게 메시지 푸시 (일대다)
# PUSHPLUS_TOPIC=
#
# 【방식 8】Discord 설정
# 두 방식 지원: Webhook (권장, 설정 간단) 과 Bot API (권한 높음)
# 
# 방식1: Discord Webhook (권장, Bot 계정 불필요)
# Discord 채널 설정 -> 통합 -> Webhook -> 새 Webhook -> URL 복사
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# 
# 방식2: Discord Bot API (Bot 계정과 채널 ID 필요)
# 1. Bot 생성: https://discord.com/developers/applications -> 새 앱 -> Bot -> Bot 생성
# 2. Bot Token 획득: Bot 페이지 -> Token 재설정
# 3. 채널 ID 획득: Discord 개발자 모드 활성화 -> 채널 우클릭 -> ID 복사
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=
# DISCORD_CHANNEL_ID=   # 구 변수명 호환, DISCORD_MAIN_CHANNEL_ID 사용 권장
# DISCORD_MAX_WORDS=2000 # Discord 단일 content 상한 2000; 런타임이 자동으로 2000 이하로 자르고 긴 보고서를 분할 전송
# Discord Interaction / Webhook 콜백을 받으려면 서명 검증용 공개키 설정 필수
# 획득 방법: Discord Developer Portal -> General Information -> Public Key
# DISCORD_INTERACTIONS_PUBLIC_KEY=
# 
# 【방식 9】Slack 설정
# 두 방식 지원: Bot API (권장) 과 Incoming Webhook
# 동시 설정 시 Bot API 우선, 텍스트와 이미지가 같은 채널로 전송되도록 보장
#
# 방식1: Slack Bot API (권장, 이미지 업로드 지원)
# 1. Slack App 생성: https://api.slack.com/apps -> Create New App
# 2. Bot Token Scopes 추가: chat:write, files:write
# 3. 워크스페이스에 설치 후 Bot Token (xoxb-...) 획득
# 4. 채널 ID 획득: 채널 상세 -> 하단에서 채널 ID 복사
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C01234567
#
# 방식2: Slack Incoming Webhook (설정 간단, 이미지 업로드 미지원)
# Slack App 관리 페이지에서 Incoming Webhook 생성 -> URL 복사
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
#
# 【방식 10】Server酱3 설정 (국내 푸시 서비스, 위챗 푸시 지원)
# Server酱3 계정 등록 후 SendKey 발급 https://sc3.ft07.com/
# SERVERCHAN3_SENDKEY=
#
# 【방식 11】AstrBot 설정
# ASTRBOT_URL=
# ASTRBOT_TOKEN=  # 선택 사항, Bearer Token 이 필요한 AstrBot Webhook용
#
# 【고급 설정】메시지 길이 제한 (바이트)
# 제한 초과 시 자동 분할 전송, 일반적으로 수정 불필요
# FEISHU_MAX_BYTES=20000    # 페이슈 제한 약 20KB, 기본 20000 바이트
# FEISHU_SEND_AS_FILE=false # true 로 설정하면 페이슈가 보고서를 파일 형태로 전송 (App Bot 모드), 기본은 텍스트 메시지
# WECHAT_MAX_BYTES=4000     # 기업 위챗 제한 4096 바이트, 기본 4000 바이트
#
# 【Markdown 이미지 변환】(Issue #455)
# Markdown 을 지원하지 않는 채널에서 보고서를 이미지로 변환해 가독성 향상
# 단일 종목 푸시 + 이미지: MARKDOWN_TO_IMAGE_CHANNELS 설정과 이미지 변환 도구 설치 동시 필요
# MARKDOWN_TO_IMAGE_CHANNELS=telegram,wechat,custom,email,slack   # 쉼표 구분
# MARKDOWN_TO_IMAGE_MAX_CHARS=15000   # 이 길이 초과 시 변환하지 않아 초대형 이미지 방지
# MD2IMG_ENGINE=wkhtmltoimage   # wkhtmltoimage(기본) | markdown-to-file | playwright (Web 의존성과 npx playwright install chromium 필요)
# 공유 이미지는 기본적으로 저장소 내장 샤오홍슈 QR 코드와 닉네임 @霸天土小豆 표시; 아래 설정으로 브랜드 정보 전체 교체 가능
# SHARE_IMAGE_XIAOHONGSHU_URL=
# SHARE_IMAGE_XIAOHONGSHU_HANDLE=@霸天土小豆  # 전부 비워두면 내장 닉네임 표시
# SHARE_IMAGE_XIAOHONGSHU_QR_PATH=assets/my-xiaohongshu-qr.png  # 전부 비워두면 내장 QR 코드 사용
# 이미지 변환 도구: wkhtmltopdf (apt install wkhtmltopdf / brew install wkhtmltopdf), 또는 markdown-to-file
#
# 【알림 라우팅 전략】(Issue #1200 P3)
# 기본 비움: 해당 유형 알림을 설정된 모든 채널로 전송. 입력 후 나열된 설정된 채널에만 전송
# 허용 값: wechat,dingtalk,feishu,telegram,email,pushover,ntfy,gotify,pushplus,serverchan3,custom,discord,slack,astrbot
# NOTIFICATION_REPORT_CHANNELS=
# NOTIFICATION_ALERT_CHANNELS=
# NOTIFICATION_SYSTEM_ERROR_CHANNELS=
#
# 【알림 노이즈 감소 메커니즘】(Issue #1200 P4)
# 기본 전부 비활성; 정적 알림 채널에만 영향, 로봇 트리거 세션 응답에는 영향 없음
# NOTIFICATION_DEDUP_TTL_SECONDS=0      # 같은 안정 중복 제거 key 를 TTL 내에서 한 번만 전송; 0 비활성
# NOTIFICATION_COOLDOWN_SECONDS=0       # 같은 쿨다운 key 를 창 내에서 빈도 제한; 0 비활성
# NOTIFICATION_QUIET_HOURS=             # 조용한 시간대, 형식 HH:MM-HH:MM, 자정 넘김 지원
# NOTIFICATION_TIMEZONE=                # 조용한 시간대 시간대, 예 Asia/Shanghai; 비워두면 TZ/시스템 로컬 시간대 따름
# NOTIFICATION_MIN_SEVERITY=            # info,warning,error,critical; 비워두면 현상 유지
# NOTIFICATION_DAILY_DIGEST_ENABLED=false  # 예약 설정; 현재 일일 요약은 전송하지 않음
#
# 【실시간 시세 미리 가져오기】(Issue #455)
# PREFETCH_REALTIME_QUOTES=true   # false 로 설정하면 비활성, efinance/akshare_em 전시장 가져오기 방지; tushare 는 단일 종목 인터페이스, 미리 가져오기는 첫 종목만 가져옴

# ===================================
# 단일 종목 푸시 설정 (선택 사항)
# ===================================
# 단일 종목 푸시 모드: 종목 하나 분석이 끝날 때마다 즉시 푸시, 모아 푸시하지 않음
# SINGLE_STOCK_NOTIFY=false
#
# 보고서 유형: simple(간략), full(전체), brief(3-5문장 요약)
# Docker 환경에서 푸시 내용이 불완전하면 full 로 설정 가능
# REPORT_TYPE=simple
# 보고서 출력 언어: zh(중국어, 기본) / en(영어) / ko(한국어)
# REPORT_LANGUAGE=zh
# 분석 결과 요약만: true 로 설정하면 요약만 푸시, 개별 종목 상세 제외
# REPORT_SUMMARY_ONLY=false
# 알림 보고서 하단에 이번 분석에 사용한 LLM 모델 이름 표시; false 로 설정하면 숨김
# REPORT_SHOW_LLM_MODEL=true
#
# Report Engine P0 (Jinja2 / 완전성 검증 / 이력 비교)
# REPORT_TEMPLATES_DIR=templates
# REPORT_RENDERER_ENABLED=false
# REPORT_INTEGRITY_ENABLED=true
# REPORT_INTEGRITY_RETRY=1
# REPORT_HISTORY_COMPARE_N=0

# 개별 종목 분석과 시장 복기 병합 푸시 (기본 false), 메일 수 감소·스팸 위험 완화
# MERGE_EMAIL_NOTIFICATION=false

# ===================================
# 분석 간격 설정 (선택 사항)
# ===================================
# 개별 종목 분석과 시장 분석 사이의 지연 시간 (초)
# Gemini 등 AI API 속도 제한 방지를 위해 사용
# ANALYSIS_DELAY=0

# 앱 AppKey (Webhook 모드와 공용)
DINGTALK_APP_KEY=xxxx
# 앱 AppSecret (Webhook 모드와 공용)
DINGTALK_APP_SECRET=xxxx
# Stream 모드 활성화
DINGTALK_STREAM_ENABLED=false

# 페이슈 앱 설정 (App Bot 능동 푸시 / Stream Bot / 클라우드 문서용; 그룹 Webhook 푸시를 직접 켜지 않음)
FEISHU_APP_ID=xxxx
FEISHU_APP_SECRET=xxxx  # App Bot 능동 푸시에는 FEISHU_CHAT_ID 도 필요; 간단한 그룹 푸시는 FEISHU_WEBHOOK_URL 우선 사용
# App Bot 능동 푸시 대상; Stream Bot 또는 클라우드 문서에는 불필요
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxxx
# FEISHU_RECEIVE_ID_TYPE=chat_id
# 장연결 모드 활성화
FEISHU_STREAM_ENABLED=false
# 페이슈 그룹 로봇 Webhook 보안 설정 (Webhook 푸시 모드에서만 사용)
# FEISHU_WEBHOOK_SECRET=your_feishu_webhook_secret
# FEISHU_WEBHOOK_KEYWORD=주식일보

# 데이터베이스 경로
DATABASE_PATH=./data/stock_analysis.db
# SQLite 쓰기 최적화: 파일 DB 기본 WAL 활성화, 일괄 쓰기와 동시 회신 시 락 경쟁 완화
SQLITE_WAL_ENABLED=true
# SQLite 락 대기 타임아웃 (밀리초)
SQLITE_BUSY_TIMEOUT_MS=5000
# SQLite 가 database is locked / database table is locked 를 만났을 때 최대 재시도 횟수
SQLITE_WRITE_RETRY_MAX=3
# SQLite 쓰기 재시도 기본 백오프 시간 (초, 지수 백오프로 증가)
SQLITE_WRITE_RETRY_BASE_DELAY=0.1

# 분석 이력 스냅샷: false 로 설정하면 전체 context_snapshot 을 영속화하지 않음
# enhanced_context, market_phase_summary, AnalysisContextPack overview, diagnostics 및 raw snapshot 필드 포함
SAVE_CONTEXT_SNAPSHOT=true

# ===================================
# 백테스트 설정 (선택 사항)
# ===================================
# 백테스트 활성화 여부 (true/false)
BACKTEST_ENABLED=true
# 백테스트 평가 창 (거래일 수)
BACKTEST_EVAL_WINDOW_DAYS=10
# N일 전 분석 기록만 백테스트 (당일/최근 데이터 불완전 방지)
BACKTEST_MIN_AGE_DAYS=14
# 백테스트 엔진 버전 (백테스트 로직 업그레이드 시 결과 구분용)
BACKTEST_ENGINE_VERSION=v1
# 중립 구간 임계값 (%), 예: 2 는 -2%~+2% 를 횡보로 취급
BACKTEST_NEUTRAL_BAND_PCT=2.0

# ===================================
# ETF 로테이션 설정 (선택 사항, python main.py --etf-rotation 에서만 사용)
# 규칙 설명은 docs/etf-rotation.md; 아래는 모두 기본값
# ===================================
# 리스크 풀 (쉼표 구분): 상해심천300/중증500/창업판/배당저변동/나스닥/금
# ETF_ROTATION_POOL=510300,510500,159915,512890,513100,518880
# 방어 자산 (화폐 ETF), 비워두면 현금 보유
# ETF_ROTATION_SAFE_ASSET=511880
# 모멘텀 창 (거래일)
# ETF_ROTATION_LOOKBACK_DAYS=60
# 리밸런싱 주기: weekly / monthly
# ETF_ROTATION_REBALANCE=weekly
# 동시에 최대 몇 종목 보유
# ETF_ROTATION_TOP_N=2
# 교체 버퍼 (퍼센트포인트), 이미 보유한 종목이 이 값 이하로 뒤처지면 계속 보유
# ETF_ROTATION_SWITCH_BUFFER_PCT=2.0
# 편도 거래 비용 (bp)
# ETF_ROTATION_COST_BPS=10
# 백테스트 이력 연수
# ETF_ROTATION_BACKTEST_YEARS=8

# === 스케줄 작업 설정 ===
# 스케줄 진입점은 하나만 유지하는 것을 권장; DATABASE_PATH 를 공유하는 CLI/Web 일일 작업은 계획된 시각으로 중복 제거
# 시작 즉시 실행과 수동 재실행은 중복 제거하지 않음; 클레임 후 실패 시 수동 재시도 필요, 자세한 내용은 docs/DEPLOY.md
# 스케줄 작업 활성화 여부 (true/false)
SCHEDULE_ENABLED=false
# 매일 실행 시각 (HH:MM 형식, 24시간제)
SCHEDULE_TIME=18:00
# 다중 시각 실행 목록 (쉼표 구분, 비워두면 SCHEDULE_TIME 사용)
SCHEDULE_TIMES=
# Web/API runtime scheduler 단일 분석 하드 타임아웃 (초, 최소 60초)
DSA_RUNTIME_SCHEDULER_TIMEOUT_SECONDS=2700
# 하드 타임아웃 후 이미 저장된 개별 종목의 부분 완료 알림을 푸시할지 여부 (true/false; 기본 true, 미설정 시 활성, 이전에는 타임아웃 시 푸시하지 않음)
DSA_TIMEOUT_PARTIAL_NOTIFY=true
# 스케줄 모드 시작 시 즉시 한 번 분석을 실행할지 여부 (true/false)
# 명시적으로 설정하지 않으면 스케줄 모드는 RUN_IMMEDIATELY 의 런타임 덮어쓰기 의미를 따라 구 설정과 호환
SCHEDULE_RUN_IMMEDIATELY=true
# 비스케줄 모드 시작 시 즉시 한 번 분석을 실행할지 여부 (true/false)
RUN_IMMEDIATELY=true
# 시장 복기 활성화 여부 (true/false)
MARKET_REVIEW_ENABLED=true
# 시장 환경 요약을 개별 종목 분석 Prompt 에 주입하고 보수적 가드를 활성화할지 여부 (true/false, 기본 활성)
DAILY_MARKET_CONTEXT_ENABLED=true
# 시장 복기 시장 지역: cn(A주), hk(홍콩주), us(미국주), jp(일본주), kr(한국주), both(전체 시장);
# 쉼표 부분 집합 지원 (예: cn,us,kr); 잘못된 값/빈 값은 cn 으로 폴백. cn/hk/us/jp/kr 은 해당 단일 지역만 관심 있는 사용자에 적합
# MARKET_REVIEW_REGION=cn
# 시장 복기 지수 등락 색상: green_up=초록 상승·빨강 하락 (기본), red_up=빨강 상승·초록 하락
# MARKET_REVIEW_COLOR_SCHEME=green_up

# ===================================
# 프록시 설정 (선택 사항)
# ===================================
# 프록시 활성화 여부 (true/false, 기본 false)
# 로컬 개발 환경에서만 유효, GitHub Actions 환경에서는 자동 건너뜀
USE_PROXY=false
# 프록시 서버 주소 (기본 127.0.0.1)
PROXY_HOST=127.0.0.1
# 프록시 서버 포트 (기본 10809)
PROXY_PORT=10809

# 시스템 설정
# 로그 디렉터리
LOG_DIR=./logs
# 로그 레벨 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# LiteLLM 내부 로그 레벨 (DEBUG/INFO/WARNING/ERROR/CRITICAL; 기본 WARNING; 내부 스트리밍/라우팅 세부사항 조사 시 임시로 DEBUG 설정 가능)
# LITELLM_LOG_LEVEL=WARNING
# 최대 동시 스레드 수 (차단 방지를 위해 낮은 동시성 유지 권장)
MAX_WORKERS=3
# 디버그 로그 활성화 여부
DEBUG=false

# ===================================
# WebUI 설정 (선택 사항)
# ===================================
# 기본적으로 WebUI 를 시작할지 여부 (true/false, 기본 false)
WEBUI_ENABLED=false
# WebUI 리스닝 주소 (기본 127.0.0.1; Docker/클라우드 서버에서는 0.0.0.0 으로 설정해야 외부망 접근 가능, 자세한 내용은 docs/deploy-webui-cloud.md)
WEBUI_HOST=127.0.0.1
# WebUI 리스닝 포트 (기본 8000)
WEBUI_PORT=8000
# Web 서비스 시작 전 프론트엔드 자동 빌드 여부 (npm install && npm run build, 기본 true)
WEBUI_AUTO_BUILD=true
# 단일 계층 신뢰 리버스 프록시 (예: Nginx → App) 아래에서 X-Forwarded-For 를 신뢰해 실제 IP 획득, 가장 오른쪽 값을 로그인 속도 제한에 사용; 다단계 프록시/CDN 시나리오에서는 속도 제한 key 가 엣지 프록시 IP 로 퇴화할 수 있어 추가 평가 필요; 공망 직접 연결 시 false 유지로 위조 방지
# TRUST_X_FORWARDED_FOR=false

# ===================================
# Web 로그인 인증 (선택 사항)
# ===================================
# true 로 설정하면 비밀번호 보호 활성화; 최초 방문 시 웹에서 초기 비밀번호 설정, 「시스템 설정 > 비밀번호 변경」에서 수정 가능
# 비밀번호를 잊으면 서버에서 실행: python -m src.auth reset_password
ADMIN_AUTH_ENABLED=false
# ADMIN_SESSION_MAX_AGE_HOURS=24  # Session 유효 기간 (시간)

# ===========================================
# 이미지 인식 주식 코드 (설정 페이지「이미지에서 추가」)
# ===========================================
# 단일 요청 타임아웃 60초; 이미지 최대 5MB
# GEMINI_API_KEY, ANTHROPIC_API_KEY 또는 OPENAI_API_KEY 중 하나 이상 설정 필요 (Vision 능력 모델)

# ===========================================
# Data Fetcher Priority Configuration
# ===========================================
# 숫자가 작을수록 우선순위 높음 (먼저 시도)
# 기본 우선순위: efinance(0) > akshare(1) > tushare/pytdx(2) > baostock(3) > yfinance(4) > tencent(5)
# 위 우선순위는 일반 A주 일봉 공통 경로만 제어
# IndexRegistry 에 등록된 상해심천 지수 (현재 sh000016, sh000688, sz399001, sz399006, sh000300)
# 는 고정으로 Tencent > AkShare > TickFlow > YFinance 순으로 시도하며, 이 *_PRIORITY 설정을 읽지 않음; 미설정 또는 사용 불가 소스는 건너뜀
# 명시적 시장 입력 (예: sh000016 또는 000016.SH) 만 지수 경로를 트리거; 단순 000016 은 여전히 주식으로 처리
# 미국 주식의 경우 YFINANCE_PRIORITY=0 으로 설정해 Yahoo Finance 를 먼저 사용

# EFINANCE_PRIORITY=0      # EastMoney (중국) - 기본: 0
# EFINANCE_CALL_TIMEOUT=30 # efinance API 호출 타임아웃 (초); eastmoney 호스트에 도달할 수 없을 때 무한 대기 방지. 기본: 30
# AKSHARE_PRIORITY=1       # AkShare (중국) - 기본: 1
# TUSHARE_PRIORITY=2       # Tushare Pro (중국) - 기본: 2
# TICKFLOW_PRIORITY=2      # TickFlow (일반 A주 일봉) - 기본: 2; 선택 사항, TICKFLOW_API_KEY 설정 필요
# PYTDX_PRIORITY=2         # Tongdaxin (중국) - 기본: 2
#
# Pytdx 커스텀 서버 (인트라넷/배포용): 내장 공용 서버 대신 커스텀 호스트 사용
# PYTDX_HOST=192.168.1.100
# PYTDX_PORT=7709
# 또는 다중 서버: PYTDX_SERVERS=ip1:port1,ip2:port2
# BAOSTOCK_PRIORITY=3      # Baostock (중국) - 기본: 3
# YFINANCE_PRIORITY=4      # Yahoo Finance (글로벌) - 기본: 4
# TENCENT_PRIORITY=5       # 텐센트 직접 일봉 - 일반 A주 최후 폴백.
#                          # 등록된 지수는 이 값을 무시. 기본: 5

# 예시: 미국 주식에서 Yahoo Finance 우선
# YFINANCE_PRIORITY=0
# EFINANCE_PRIORITY=99

# ===========================================
# 실시간 시세 데이터 소스 우선순위 설정
# ===========================================
# 거래량 비율, 회전율, 주가수익비율 등 실시간 데이터 획득용
# 선택 가능한 데이터 소스 (쉼표 구분, 순서대로 시도):
#   - tencent: 텐센트 파이낸스, 거래량 비율/회전율/PE/PB 있음, 단일 종목 조회 안정적 (권장 1순위)
#   - akshare_sina: 시나 파이낸스, 기본 시세, 거래량 비율 없음, 매우 안정적
#   - efinance: 동방재부(efinance 라이브러리), 거래량 비율 있음, 전량 가져오기 시 차단되기 쉬움
#   - akshare_em: 동방재부(akshare 라이브러리), 데이터 가장 완전, 전량 가져오기 시 차단되기 쉬움
#   - tickflow: TickFlow, 선택 사항; 우선순위 상위 2위일 때 현재 종목 기준 일괄 미리 가져오기 지원
#   - tushare: Tushare Pro, 2000 포인트 필요, 데이터 포괄적 (유료 사용자 권장)
#
# 기본 우선순위: tencent > akshare_sina > efinance > akshare_em
# Tushare Pro 고포인트 계정이 있으면 tushare 를 맨 앞에 둘 수 있음:
# REALTIME_SOURCE_PRIORITY=tickflow,tencent,akshare_sina,efinance,akshare_em
# REALTIME_SOURCE_PRIORITY=tushare,tencent,akshare_sina,efinance,akshare_em
# REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em

# 실시간 시세 활성화 여부 (끄면 과거 종가 분석 사용)
# ENABLE_REALTIME_QUOTE=true

# 한국 주식 실시간 시세 소스: naver (기본, Naver Finance) / yfinance (Yahoo Finance만)
# KR_REALTIME_SOURCE=naver
# Naver Finance 요청 타임아웃 (초)
# NAVER_KR_TIMEOUT_S=10
# Naver 시세/투자자 자금 흐름 캐시 TTL (초)
# NAVER_KR_QUOTE_CACHE_TTL_S=5
# NAVER_KR_FLOW_CACHE_TTL_S=60

# 장중 실시간 기술면: 활성 시 실시간 가격으로 MA/다두 배열 계산 (Issue #234); 끄면 전일 종가 사용
# ENABLE_REALTIME_TECHNICAL_INDICATORS=true

# 칩 분포 활성화 여부 (해당 인터페이스 불안정, 클라우드 배포 시 비활성 권장)
# ENABLE_CHIP_DISTRIBUTION=true

# 기본면 집계 활성화 여부 (신규 P0 기능)
# ENABLE_FUNDAMENTAL_PIPELINE=true

# 기본면 집계 성능·안정성 파라미터 (단위: 초)
# FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=8.0
# FUNDAMENTAL_RETRY_MAX=1
# FUNDAMENTAL_CACHE_TTL_SECONDS=120
# FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# ===========================================
# Portfolio P0: 가져오기 / 리스크 / 환율 폴백 설정
# ===========================================
# PORTFOLIO_RISK_CONCENTRATION_ALERT_PCT=35.0
# PORTFOLIO_RISK_DRAWDOWN_ALERT_PCT=15.0
# PORTFOLIO_RISK_STOP_LOSS_ALERT_PCT=10.0
# PORTFOLIO_RISK_STOP_LOSS_NEAR_RATIO=0.8
# PORTFOLIO_RISK_LOOKBACK_DAYS=180
# PORTFOLIO_FX_UPDATE_ENABLED=true

# 동방재부 인터페이스 패치: 동방재부/Efinance/Akshare 동방재부 인터페이스가 자주 실패(RemoteDisconnected, 연결 종료)할 때 활성화 권장
# 활성화 후 NID 토큰과 랜덤 User-Agent 를 주입해 동방재부 속도 제한 확률 감소
# ENABLE_EASTMONEY_PATCH=false

# Optional FXMacroData 인증; 공개 USD 데이터는 키 없이도 동작
FXMACRODATA_API_KEY=
